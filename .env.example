# OpenRouter is used for Jev only.
OPENROUTER_API_KEY=sk-or-v1-...

# The agent's chat models run on Amazon Bedrock with your default AWS credentials
# (AWS_PROFILE / env vars / SSO). Optional overrides:
# BEDROCK_REGION=us-east-1
# FAST_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
# POWERFUL_MODEL=global.anthropic.claude-sonnet-5
# JEV_MODEL=typesafe/jev-1.13
